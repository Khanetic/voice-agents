ENVIRONMENT=development
DATABASE_BACKEND=supabase          # supabase | memory
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=         # from `supabase status`
LLM_PROVIDER=ollama                # ollama | bedrock | fake
OLLAMA_MODEL=qwen2.5:7b
AWS_REGION=eu-central-1
BEDROCK_MODEL_ID=                  # eu.* Claude Haiku inference profile from Bedrock console
VOICE_PROVIDER=browser_dev         # browser_dev | elevenlabs | nova_sonic
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
TOOL_WEBHOOK_SECRET=               # openssl rand -hex 32
FIREHOSE_STREAM=
CORS_ORIGINS=["http://localhost:3010"]
