ENVIRONMENT=development
# supabase | memory
DATABASE_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:54321
# from `supabase status`
SUPABASE_SERVICE_ROLE_KEY=
# ollama | bedrock | fake
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3.5:latest
AWS_REGION=eu-central-1
# eu.* Claude Haiku inference profile from Bedrock console
BEDROCK_MODEL_ID=
# browser_dev | elevenlabs | nova_sonic
VOICE_PROVIDER=browser_dev
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# openssl rand -hex 32
TOOL_WEBHOOK_SECRET=
FIREHOSE_STREAM=
CORS_ORIGINS=["http://localhost:3010"]
